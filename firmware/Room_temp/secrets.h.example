// secrets.h.example — copy this file to secrets.h and fill in your values.
//   cp secrets.h.example secrets.h   (secrets.h is gitignored — never commit it)
//
// These are the default credentials baked into the firmware. The WiFiManager
// captive portal can still override any of them per-device; values are only
// written to EEPROM if the user submits the portal form.
#pragma once

// Optional Wi-Fi defaults baked into every unit. WiFiMulti auto-connects to
// whichever of these is in range with the strongest signal; the captive portal
// and the /config page can override them per-device. Leave any slot blank ("")
// to configure it only through the portal. All three are optional.
#define DEFAULT_WIFI1_SSID  "Office-WiFi"
#define DEFAULT_WIFI1_PASS  "CHANGE_ME"
#define DEFAULT_WIFI2_SSID  "Office-WiFi-5G"
#define DEFAULT_WIFI2_PASS  "CHANGE_ME"
#define DEFAULT_WIFI3_SSID  ""
#define DEFAULT_WIFI3_PASS  ""

#define DEFAULT_MQTT_HOST   "your-cluster.s1.eu.hivemq.cloud"
#define DEFAULT_MQTT_PORT   "8883"
#define DEFAULT_MQTT_USER   "esp_pub"
#define DEFAULT_MQTT_PASS   "CHANGE_ME"
#define DEFAULT_MQTT_BASE   "room"

// Google Apps Script Web App. GS_PATH is the /macros/s/<DEPLOYMENT_ID>/exec
// part of your deployment URL.
#define DEFAULT_GS_HOST     "script.google.com"
#define DEFAULT_GS_PATH     "/macros/s/PASTE_DEPLOYMENT_ID/exec"

// Project name — becomes the tab name in the shared spreadsheet so one
// Apps Script can serve many IoT projects (each in its own sheet tab).
#define DEFAULT_PROJECT     "room_temp"

// Default device ID — change in the captive portal for each unit (room1..room10).
#define DEFAULT_DEVICE_ID   "room1"

// Optional OTA upload password. Comment out to disable password auth.
// Also used as the fallback admin password for the local /config page.
#define OTA_PASSWORD        "CHANGE_ME"

// WPA2 password for the RoomTemp-Setup captive portal (8+ characters, same
// value on the whole fleet — print it on the deployment sheet). Leave this
// out and the setup AP is OPEN: anyone in radio range can retype the Wi-Fi
// and the broker of a device someone else installed.
#define PORTAL_AP_PASSWORD  "CHANGE_ME"

// Optional "pull" firmware URL for the periodic HTTP OTA check (plain http://
// on the LAN; https is not supported — the TLS buffers don't fit next to the
// MQTT session). Each device can override it on its own /config page; leave
// it blank to disable the check entirely.
#define DEFAULT_OTA_URL     ""
// The share \\14.11.0.85\Drug\AutoPrint\IOT\Roomtemp served over HTTP:
// #define DEFAULT_OTA_URL  "http://14.11.0.85/Drug/AutoPrint/IOT/Roomtemp/firmware.bin"

// Optional basic auth for that URL. Empty user = no Authorization header.
#define OTA_HTTP_USER       ""
#define OTA_HTTP_PASS       ""
